{
  "skill": "vercel-react-native-skills",
  "intro": "Read the individual rule only when the changed React Native code matches its condition. A rule's priority is a triage hint, not permission to ignore repository policy.",
  "categories": [
    {
      "prefix": "rendering",
      "title": "Core rendering"
    },
    {
      "prefix": "list-performance",
      "title": "List performance"
    },
