      "file_signals": [
        "from\\s+['\"](?:react-native(?:-[\\w-]+)?|expo(?:-[\\w-]+)?|@expo/[\\w-]+|@react-navigation/[\\w-]+|@shopify/flash-list|@legendapp/list)(?:/[^'\"]*)?['\"]"
      ]
